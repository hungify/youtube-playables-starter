{
    "name": "{{PACKAGE_NAME}}",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "format": "oxfmt src test scripts e2e vite.config.ts playwright.config.ts",
        "format:check": "oxfmt --check src test scripts e2e vite.config.ts playwright.config.ts",
        "lint": "oxlint",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
        "validate": "bun scripts/validate-playable.ts",
        "zip": "bun run check && bun run build && bun run validate --zip",
        "test:e2e": "playwright test",
        "prepare": "git config core.hooksPath .githooks || true"
    },
    "dependencies": {},
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/bun": "^1.4.3",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "terser": "^5.34.1",
        "typescript": "^7.0.2",
        "vite": "^5.4.8"
    },
    "engines": {
        "bun": ">=1.4.0"
    },
    "packageManager": "bun@1.4.3"
}
